</div></footer>
</div>
<script>var SEARCH_INDEX=[{"t": "一个很好的人，为什么会突然离开", "e": "好人不长寿，祸害活千年", "u": "articles/一个很好的人为什么会突然离开.html"}, {"t": "三代之间必降兴家之子", "e": "每一个家族的翻身", "u": "articles/三代之间必降兴家之子.html"}, {"t": "三观是什么", "e": "你读过的书，走过的路，见过的人，就是你的世界观，一个人的世界观，由他", "u": "articles/三观是什么.html"}, {"t": "世界的本质", "e": "确定论", "u": "articles/世界的本质.html"}, {"t": "事情的第一核心", "e": "1. 家庭的第一核心，是经济，而不是感情。经济基础直接决定家庭的安稳度，光靠情绪维系，终究很难扛住现实的风雨。 \n\n2. 职场的第一准则，是价值，而不是努力。只懂埋头苦干却不提升核心竞争力，很容易被替", "u": "articles/事情的第一核心.html"}, {"t": "亲子关系是什么", "e": "成为孩子背后的山", "u": "articles/亲子关系是什么.html"}, {"t": "人不可能每一步都正确", "e": "我们不能站在现在的高度", "u": "articles/人不可能每一步都正确.html"}, {"t": "人和人关系的本质是什么", "e": "价值交换", "u": "articles/人和人关系的本质是什么.html"}, {"t": "人在什么时候进步最快", "e": "一个人进步最快的时候", "u": "articles/人在什么时候进步最快.html"}, {"t": "人生的本质", "e": "黄仁勋在斯坦福大学的一场演讲中说：", "u": "articles/人生的本质.html"}, {"t": "人生的运气", "e": "一个人", "u": "articles/人生的运气.html"}, {"t": "什么叫开悟", "e": "如果一个人能够发现自己身上的种种缺点", "u": "articles/什么叫开悟.html"}, {"t": "什么时候大彻大悟", "e": "无人可依的时候", "u": "articles/什么时候大彻大悟.html"}, {"t": "什么是命运", "e": "当你遇见一件事", "u": "articles/什么是命运.html"}, {"t": "县城真相：世袭与垄断下的底层困局", "e": "一线城市的打工者中流传着一种格外刺耳的声音，他们认为，只要逃离了北上广深的内卷，回到看似安逸的县城，就能抬头做人，当个有头有脸的人物", "u": "articles/县城真相世袭与垄断下的底层困局.html"}, {"t": "后半句是精华", "e": "不听老人言，吃亏在眼前；尽信老人言，终身未向前", "u": "articles/后半句是精华.html"}, {"t": "处世法则", "e": "1、别轻易同情任何人，很多看似可怜的人，身上都藏着让人无奈的性格与选择", "u": "articles/处世法则.html"}, {"t": "如何有底气", "e": "一个人在社会上，怎样才算有底气？", "u": "articles/如何有底气.html"}, {"t": "婚姻是什么", "e": "一个七十多岁的老人说，“婚姻就是我午夜三点醒来的时候，口渴或者伤口疼，我只需要捅捅睡在旁边的那个人，她就知道，我要喝水”", "u": "articles/婚姻是什么.html"}, {"t": "孝心是什么", "e": "前三十年，看父敬子", "u": "articles/孝心是什么.html"}, {"t": "寒门难出贵子", "e": "寒门立志", "u": "articles/寒门难出贵子.html"}, {"t": "当滤镜褪去：吸引力的反思", "e": "当一个男人真正挣脱性欲带来的执念与滤镜，不再被原始冲动裹挟着审视异性，便会恍然惊觉：世间绝大多数女性，除去皮囊带来的视觉吸引，并无太多值得过度追捧的光环", "u": "articles/当滤镜褪去吸引力的反思.html"}, {"t": "待人接物的礼仪", "e": "左手戴金，右手戴银，背后教妻，当面教子", "u": "articles/待人接物的礼仪.html"}, {"t": "毛选解析：和任何人搞好关系的三个模型", "e": "半个月前，北京。一位研究了一辈子《毛选》的前辈，在海淀他家的书房里给我上了这辈子最重要的一课。", "u": "articles/毛选解析和任何人搞好关系的三个模型.html"}, {"t": "男人该有的样子", "e": "两种气场在一个人身上兼具", "u": "articles/男人该有的样子.html"}, {"t": "线性思维与非线性", "e": "**线性思维**与**非线性思维**在赚钱认知上的根本差异：", "u": "articles/线性思维与非线性.html"}, {"t": "结局重要还是过程重要", "e": "结局已定，就好好做过程", "u": "articles/结局重要还是过程重要.html"}, {"t": "诗词：一去不返的青春", "e": "春风若有怜花意，可否许我再少年", "u": "articles/诗词一去不返的青春.html"}, {"t": "跟过大佬后：职场斗争的四层认知颠覆", "e": "跟过真正的大佬后，才意识到职场斗争的残酷", "u": "articles/跟过大佬后职场斗争的四层认知颠覆.html"}, {"t": "顶级家族培养儿子的总结", "e": "男孩和女孩，从出生那天起，就注定了不同的培养路径：", "u": "articles/顶级家族培养儿子的总结.html"}, {"t": "高情商说话", "e": "只需要记住一点", "u": "articles/高情商说话.html"}, {"t": "传承与家族", "e": "**来源：[[顶级家族培养儿子的总结]]**", "u": "articles/传承与家族.html"}, {"t": "处世与自我保护", "e": "**来源：[[处世法则]]**", "u": "articles/处世与自我保护.html"}, {"t": "婚姻与亲密关系", "e": "**来源：[[婚姻是什么]]**", "u": "articles/婚姻与亲密关系.html"}, {"t": "接纳与安命", "e": "**来源：[[人生的本质]]**", "u": "articles/接纳与安命.html"}, {"t": "阶层与社会流动", "e": "**来源：[[县城真相：世袭与垄断下的底层困局]]**", "u": "articles/阶层与社会流动.html"}];</script>
<script>
(function(){
    var bar=document.getElementById('progressBar');
    var btn=document.getElementById('backTop');
    window.addEventListener('scroll',function(){
        var h=document.documentElement.scrollHeight-document.documentElement.clientHeight;
        var p=h>0?Math.min(100,Math.round(window.scrollY/h*100)):0;
        bar.style.width=p+'%';
        btn.classList.toggle('visible',window.scrollY>400);
    });
    var theme=localStorage.getItem('theme')||'dark';
    document.documentElement.setAttribute('data-theme',theme);
    var themeBtn=document.getElementById('themeBtn');
    if(themeBtn){ themeBtn.textContent=theme==='dark'?'☀️':'🌙'; themeBtn.onclick=function(){ theme=theme==='dark'?'light':'dark'; document.documentElement.setAttribute('data-theme',theme); localStorage.setItem('theme',theme); themeBtn.textContent=theme==='dark'?'☀️':'🌙'; }; }
    var searchBtn=document.getElementById('searchBtn');
    var searchOverlay=document.getElementById('searchOverlay');
    var searchInput=document.getElementById('searchInput');
    var searchResults=document.getElementById('searchResults');
    if(searchBtn&&searchOverlay){
        searchBtn.onclick=function(){ searchOverlay.classList.add('open'); searchInput.focus(); };
        searchOverlay.addEventListener('click',function(e){ if(e.target===searchOverlay)searchOverlay.classList.remove('open'); });
        document.addEventListener('keydown',function(e){ if(e.key==='Escape')searchOverlay.classList.remove('open'); if((e.ctrlKey||e.metaKey)&&e.key==='k'){ e.preventDefault(); searchOverlay.classList.add('open'); searchInput.focus(); } });
    }
    if(searchInput){
        searchInput.addEventListener('input',function(){
            var q=searchInput.value.trim().toLowerCase();
            searchResults.innerHTML='';
            if(!q)return;
            var hits=[];
            for(var i=0;i<SEARCH_INDEX.length;i++){
                var item=SEARCH_INDEX[i];
                var score=0;
                if(item.t.toLowerCase().indexOf(q)>=0)score+=3;
                if(item.e.toLowerCase().indexOf(q)>=0)score+=1;
                if(score>0)hits.push({item:item,score:score});
            }
            hits.sort(function(a,b){return b.score-a.score;});
            if(hits.length===0){ searchResults.innerHTML='<div class="search-empty">没有找到匹配的文章</div>'; return; }
            for(var j=0;j<Math.min(hits.length,12);j++){
                var h=hits[j].item;
                var div=document.createElement('div');
                div.className='search-result';
                div.innerHTML='<span class="search-result-title">'+h.t.replace(new RegExp('('+q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')','gi'),'<em>$1</em>')+'</span><span class="search-result-excerpt">'+h.e.substring(0,120)+'</span>';
                div.onclick=function(url){return function(){window.location.href=url;};}(h.u);
                searchResults.appendChild(div);
            }
        });
    }
})();
</script>
</body></html>